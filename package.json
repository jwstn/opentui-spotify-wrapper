{
  "name": "opentui-spotify-wrapper",
  "module": "src/index.tsx",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run --watch src/index.tsx",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --tsconfig tsconfig.json src/ test/",
    "format": "oxfmt src/ test/",
    "format:check": "oxfmt --check src/ test/",
    "test": "bun test"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "react-devtools-core": "7"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@effect/atom-react": "^4.0.0-beta.107",
    "@effect/platform-bun": "4.0.0-rc.111",
    "@opentui/core": "^0.5.6",
    "@opentui/react": "^0.5.6",
    "@tuiparts/react": ">=0.0.1 <0.1.0",
    "@types/react": "^19.2.18",
    "effect": "^4.0.0-rc.111",
    "react": "^19.2.6"
  }
}
